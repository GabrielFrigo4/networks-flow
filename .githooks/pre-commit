#!/usr/bin/env sh

REPO_ROOT="$(git rev-parse --show-toplevel 2> "/dev/null")"
if [ -n "${REPO_ROOT}" ]; then
	cd "${REPO_ROOT}" || exit 1
fi

RED='\033[1;31m'
YELLOW='\033[1;33m'
RESET='\033[0m'

is_binary() {
	file "${1}" 2> "/dev/null" | grep -qE "ELF (32|64)-bit"
}

is_artifact() {
	case "$1" in
		*.o|*.obj|*.exe|*.dll|*.so|*.dylib|*.out|*.a|*.lib|*.bin|*.elf)
			return 0
			;;
		*.aux|*.bbl|*.blg|*.log|*.toc|*.fls|*.fdb_latexmk|*.synctex.gz|*.bcf|*.run.xml|*.xdv|*.nav|*.snm|*.vrb)
			return 0
			;;
		Material/*)
			return 1
			;;
		*.pdf)
			return 0
			;;
		*.ppm|output.ppm|*seeds.ppm|segment|seeds)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

has_error=0

while IFS= read -r -d '' target; do
	[ -f "${target}" ] || continue

	if is_binary "${target}" || is_artifact "${target}"; then
		printf "%b\n" "${RED}erro:${RESET} binário ou artefato detectado no commit: '${target}'" >&2
		has_error=1
	fi
done < <(git -c core.quotepath=false diff --cached --name-only -z --diff-filter=ACM)

if [ "${has_error}" -ne 0 ]; then
	printf "%b\n" "${YELLOW}dica:${RESET} execute 'make clean' ou 'git rm --cached <arquivo>'" >&2
	exit 1
fi

if [ -f "Scripts/sync_listings.py" ]; then
	if ! python3 Scripts/sync_listings.py --check > "/dev/null" 2>&1; then
		printf "%b\n" "${RED}erro:${RESET} os apêndices LaTeX estão dessincronizados com Implementações/" >&2
		printf "%b\n" "${YELLOW}dica:${RESET} execute 'make sync-code' para atualizar os apêndices" >&2
		exit 1
	fi
fi
