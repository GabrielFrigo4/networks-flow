#!/usr/bin/env sh

### ================================
### PRE-COMMIT HOOK
### ================================

set -e

### ================================
### Setup & Repository Root
### ================================
_repo_root="$(git rev-parse --show-toplevel 2> "/dev/null" || pwd)"
cd "${_repo_root}"

echo "🔍 [pre-commit] Executing Networks Flow quality gates..."

### ================================
### Whitespace & Formatting Check
### ================================
echo "  ↳ Checking whitespace and formatting (git diff --check)..."
if ! git diff --check --cached; then
	echo "❌ [pre-commit] Whitespace or EOF formatting error detected!" >&2
	echo "   Run 'git diff --check --cached' to inspect issues." >&2
	exit 1
fi

### ================================
### Forbidden Artifacts & Binaries
### ================================
echo "  ↳ Checking for binaries and compiled LaTeX artifacts..."
_has_error=0

_is_artifact() {
	case "${1}" in
		*.o|*.obj|*.exe|*.dll|*.so|*.dylib|*.out|*.a|*.lib|*.bin|*.elf)
			return 0
			;;
		*.aux|*.bbl|*.blg|*.log|*.toc|*.fls|*.fdb_latexmk|*.synctex.gz|*.bcf|*.run.xml|*.xdv|*.nav|*.snm|*.vrb)
			return 0
			;;
		Material/*)
			return 1
			;;
		*.pdf)
			return 0
			;;
		*.ppm|output.ppm|*seeds.ppm|segment|seeds)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

_staged_files=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM)
if [ -n "${_staged_files}" ]; then
	echo "${_staged_files}" | while IFS= read -r _target; do
		[ -z "${_target}" ] && continue
		if _is_artifact "${_target}"; then
			echo "❌ [pre-commit] Binary or LaTeX artifact detected: '${_target}'" >&2
			exit 1
		fi
	done
fi

### ================================
### LaTeX & C++ Listings Sync Check
### ================================
if [ -f "Scripts/sync_listings.py" ]; then
	echo "  ↳ Validating LaTeX code listings synchronization..."
	if ! python3 Scripts/sync_listings.py --check > "/dev/null" 2>&1; then
		echo "❌ [pre-commit] LaTeX appendices are out of sync with Implementações/!" >&2
		echo "   Run 'make sync-code' before committing." >&2
		exit 1
	fi
fi

### ================================
### Markdown Prettier Validation
### ================================
if command -v prettier > "/dev/null" 2>&1; then
	echo "  ↳ Validating staged Markdown files with Prettier..."
	_unformatted_md=""
	for _md_file in $(git diff --cached --name-only --diff-filter=d | grep '\.md$' || true); do
		if [ -f "${_md_file}" ] && ! prettier --check "${_md_file}" > "/dev/null" 2>&1; then
			_unformatted_md="${_unformatted_md} ${_md_file}"
		fi
	done
	if [ -n "${_unformatted_md}" ]; then
		echo "❌ [pre-commit] Unformatted Markdown files detected:${_unformatted_md}" >&2
		echo "   Run 'prettier --write <file>'." >&2
		exit 1
	fi
fi

echo "✅ [pre-commit] All Networks Flow quality gates passed cleanly!"
exit 0
